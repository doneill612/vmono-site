---
/** Minimal site footer shared by the landing page and the docs layout. */
import { REPO_URL, url } from "../lib/nav";
---

<footer class="footer">
  <div class="inner">
    <p>vmono · MIT licensed</p>
    <nav aria-label="Footer">
      <a href={url("/docs")}>Docs</a>
      <a href={REPO_URL} rel="noopener">GitHub</a>
      <a href={`${REPO_URL}/releases`} rel="noopener">Releases</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    border-top: 1px solid var(--border-muted);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 1.5rem var(--gutter);
  }

  p {
    margin: 0;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  a {
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }
</style>
