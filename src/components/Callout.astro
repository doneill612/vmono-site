---
/**
 * A highlighted aside for docs content. `type` is `note` (default) or
 * `warning`; the body is the default slot and may contain Markdown when used
 * from MDX with blank lines around it.
 */
interface Props {
  type?: "note" | "warning";
}

const { type = "note" } = Astro.props;
---

<aside class:list={["callout", type]} role="note">
  <p class="kind" aria-hidden="true">{type === "warning" ? "warning" : "note"}</p>
  <div class="body"><slot /></div>
</aside>

<style>
  .callout {
    --tone: var(--c-cyan);
    margin: 0 0 1.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid color-mix(in srgb, var(--tone) 35%, var(--border));
    border-left: 3px solid var(--tone);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--tone) 7%, var(--bg-surface));
  }

  .callout.warning {
    --tone: var(--c-amber);
  }

  .kind {
    margin: 0 0 0.25rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tone);
  }

  .body :global(:last-child) {
    margin-bottom: 0;
  }

  .body :global(:first-child) {
    margin-top: 0;
  }
</style>
