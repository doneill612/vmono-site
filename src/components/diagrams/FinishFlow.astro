---
/**
 * Diagram for "Finishing a session": what `vmono session finish` does to one
 * member, drawn as four small commit graphs left to right.
 *
 * 1. Start: the session branch (green commits) forked from the landing
 *    branch (rose label) before the landing branch moved on.
 * 2. Rebase: in the session's worktree, the session's commits are replayed on
 *    top of the landing branch.
 * 3. Land: in the source repo, the landing branch moves to the result.
 * 4. Push: a separate step, dashed because nothing is pushed unless asked;
 *    the remote still sits where the landing branch started.
 *
 * Under the graphs, a band states the all-or-nothing gate. Plain inline SVG in
 * a 760x256 viewBox, colored from the site tokens like the other diagrams.
 *
 * The markup is the finished, static state. Every panel is visible from the
 * first paint and loops on its own, so a reader skimming past sees all four
 * steps move without waiting for a sequence. Each panel's graph sits in a
 * `.stage` group that fades in and out once per cycle, and a few elements
 * inside it move between where the previous step left them and where this
 * step puts them:
 *
 * - Start: the landing branch moves on (a new commit appears, its label moves).
 * - Rebase: the session commits slide from the fork point onto the new tip.
 * - Land: they rise onto the landing branch (the diagonal edge fades) and the
 *   landing label moves to the new tip.
 * - Push: `origin/main` moves to the new tip while the dashed arrow flows.
 *
 * All the loops share one 5s period so the keyframe percentages line up: the
 * motion happens between 18% and 40%, then the result holds until the fade.
 * The animation rules are inside a `prefers-reduced-motion: no-preference`
 * query; reduced-motion visitors see the static drawing.
 */
import Figure from "../Figure.astro";

/** Panel x origins: Start, Rebase, Land, Push. Each panel is 150 wide. */
const [p0, p1, p2, p3] = [20, 210, 400, 590] as const;
---

<Figure caption="finish rebases the session's commits onto the landing branch, then moves the landing branch to the result. Pushing is a separate step you ask for.">
  <svg viewBox="0 0 760 256" role="img" aria-labelledby="finish-flow-title finish-flow-desc">
    <title id="finish-flow-title">What finishing a session does</title>
    <desc id="finish-flow-desc">
      The session's commits are rebased onto the landing branch in the session's worktree, the landing branch in the source repo moves to the result, and pushing is a separate step. Nothing moves unless every member can land.
    </desc>
    <defs>
      <marker id="finish-flow-head" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L8 4 L0 8 z" class="head"></path>
      </marker>
    </defs>

    <rect class="gate" x="20" y="202" width="720" height="40" rx="8"></rect>
    <rect class="gate-bar" x="20" y="202" width="4" height="40" rx="2"></rect>
    <text class="gate-text" x="40" y="226">Nothing moves unless every member can land: if one cannot, finish exits 2 and changes nothing.</text>

    <path class="link" d="M172 100 H202" marker-end="url(#finish-flow-head)"></path>
    <path class="link" d="M362 100 H392" marker-end="url(#finish-flow-head)"></path>
    <path class="link" d="M552 100 H582" marker-end="url(#finish-flow-head)"></path>

    <!-- Panel 1: Start -->
    <rect class="panel" x={p0} y="8" width="150" height="178" rx="8"></rect>
    <text class="title" x={p0 + 12} y="30">Start</text>
    <text class="muted" x={p0 + 12} y="46">forked earlier</text>
    <g class="stage">
      <path class="edge" d={`M${p0 + 20} 100 H${p0 + 50}`}></path>
      <path class="edge appear" d={`M${p0 + 50} 100 H${p0 + 80}`}></path>
      <path class="edge own" d={`M${p0 + 50} 100 L${p0 + 80} 145 H${p0 + 110}`}></path>
      {[20, 50].map((x) => <circle class="dot" cx={p0 + x} cy="100" r="6"></circle>)}
      <circle class="dot pop" cx={p0 + 80} cy="100" r="6"></circle>
      {[80, 110].map((x) => <circle class="dot own" cx={p0 + x} cy="145" r="6"></circle>)}
      <text class="tag rose labelmove" x={p0 + 80} y="80">landing</text>
      <text class="tag green" x={p0 + 110} y="168">session</text>
    </g>

    <!-- Panel 2: Rebase -->
    <rect class="panel" x={p1} y="8" width="150" height="178" rx="8"></rect>
    <text class="title" x={p1 + 12} y="30">1. Rebase</text>
    <text class="muted" x={p1 + 12} y="46">session worktree</text>
    <g class="stage">
      <path class="edge" d={`M${p1 + 20} 100 H${p1 + 80}`}></path>
      {[20, 50, 80].map((x) => <circle class="dot" cx={p1 + x} cy="100" r="6"></circle>)}
      <text class="tag rose" x={p1 + 80} y="80">landing</text>
      <g class="slide">
        <path class="edge own" d={`M${p1 + 80} 100 L${p1 + 110} 145 H${p1 + 140}`}></path>
        {[110, 140].map((x) => <circle class="dot own" cx={p1 + x} cy="145" r="6"></circle>)}
        <text class="tag green end" x={p1 + 140} y="168">session</text>
      </g>
    </g>

    <!-- Panel 3: Land -->
    <rect class="panel" x={p2} y="8" width="150" height="178" rx="8"></rect>
    <text class="title" x={p2 + 12} y="30">2. Land</text>
    <text class="muted" x={p2 + 12} y="46">source repo</text>
    <g class="stage">
      <path class="edge" d={`M${p2 + 20} 100 H${p2 + 80}`}></path>
      <path class="edge own ghost" d={`M${p2 + 80} 100 L${p2 + 110} 145 H${p2 + 140}`}></path>
      <path class="edge late" d={`M${p2 + 80} 100 H${p2 + 140}`}></path>
      {[20, 50, 80].map((x) => <circle class="dot" cx={p2 + x} cy="100" r="6"></circle>)}
      <g class="rise">
        {[110, 140].map((x) => <circle class="dot own" cx={p2 + x} cy="100" r="6"></circle>)}
      </g>
      <text class="tag rose ghost" x={p2 + 80} y="80">landing</text>
      <text class="tag rose end late" x={p2 + 140} y="80">landing</text>
      <text class="tag green end late" x={p2 + 140} y="124">session</text>
    </g>

    <!-- Panel 4: Push -->
    <rect class="panel dashed" x={p3} y="8" width="150" height="178" rx="8"></rect>
    <text class="title" x={p3 + 12} y="30">3. Push</text>
    <text class="muted" x={p3 + 12} y="46">only when you ask</text>
    <g class="stage">
      <path class="edge" d={`M${p3 + 16} 100 H${p3 + 112}`}></path>
      {[16, 40, 64].map((x) => <circle class="dot" cx={p3 + x} cy="100" r="6"></circle>)}
      {[88, 112].map((x) => <circle class="dot own" cx={p3 + x} cy="100" r="6"></circle>)}
      <text class="tag rose" x={p3 + 112} y="80">landing</text>
      <path class="push flow" d={`M${p3 + 64} 140 H${p3 + 112}`} marker-end="url(#finish-flow-head)"></path>
      <text class="tag" x={p3 + 88} y="162">push</text>
      <text class="tag shift" x={p3 + 64} y="124">origin/main</text>
    </g>
  </svg>
</Figure>

<style>
  svg {
    font-family: var(--font-mono);
    font-size: 10.5px;
  }

  .title {
    font-size: 13px;
    font-weight: 700;
    fill: var(--text);
  }

  .muted {
    fill: var(--text-muted);
  }

  .tag {
    font-size: 10.5px;
    font-weight: 700;
    text-anchor: middle;
    fill: var(--text-muted);
  }

  .tag.end {
    text-anchor: end;
  }

  .tag.rose {
    fill: var(--c-rose);
  }

  .tag.green {
    fill: var(--c-green);
  }

  .panel {
    fill: var(--bg-elevated);
    stroke: var(--border);
  }

  .panel.dashed {
    stroke-dasharray: 5 4;
  }

  .edge {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 2;
  }

  .edge.own {
    stroke: var(--c-green);
  }

  .dot {
    fill: var(--text-muted);
  }

  .dot.own {
    fill: var(--c-green);
  }

  .link {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
  }

  .push {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
  }

  .head {
    fill: var(--text-muted);
  }

  .gate {
    fill: color-mix(in srgb, var(--c-amber) 8%, var(--bg-surface));
    stroke: color-mix(in srgb, var(--c-amber) 35%, var(--border));
  }

  .gate-bar {
    fill: var(--c-amber);
  }

  .gate-text {
    font-size: 11.5px;
    fill: var(--text-secondary);
  }

  /* Elements that exist only while the animation runs. */
  .ghost {
    opacity: 0;
  }

  /*
   * The loops. One 5s period for everything: motion between 18% and 40%, the
   * result held until the stage fades at 90-97%, then it fades back in at the
   * starting positions. Gated so reduced-motion visitors get the static drawing.
   */
  @media (prefers-reduced-motion: no-preference) {
    .stage {
      animation: fadecycle 5s ease-in-out infinite;
    }

    .appear {
      animation: appear 5s ease-in-out infinite;
    }

    .pop {
      transform-box: fill-box;
      transform-origin: center;
      animation: pop 5s ease-in-out infinite;
    }

    .labelmove {
      animation: labelmove 5s ease-in-out infinite;
    }

    .slide {
      animation: slide 5s ease-in-out infinite;
    }

    .rise {
      animation: rise 5s ease-in-out infinite;
    }

    .ghost {
      animation: ghost 5s ease-in-out infinite;
    }

    .late {
      animation: appear2 5s ease-in-out infinite;
    }

    .shift {
      animation: shift 5s ease-in-out infinite;
    }

    .push.flow {
      animation: dashflow 0.8s linear infinite;
    }
  }

  @keyframes fadecycle {
    0% {
      opacity: 0;
    }
    5%,
    90% {
      opacity: 1;
    }
    97%,
    100% {
      opacity: 0;
    }
  }

  @keyframes appear {
    0%,
    18% {
      opacity: 0;
    }
    30%,
    100% {
      opacity: 1;
    }
  }

  @keyframes pop {
    0%,
    18% {
      opacity: 0;
      transform: scale(0.4);
    }
    30%,
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes labelmove {
    0%,
    18% {
      transform: translateX(-30px);
    }
    40%,
    100% {
      transform: none;
    }
  }

  @keyframes slide {
    0%,
    18% {
      transform: translateX(-30px);
    }
    40%,
    100% {
      transform: none;
    }
  }

  @keyframes rise {
    0%,
    18% {
      transform: translateY(45px);
    }
    40%,
    100% {
      transform: none;
    }
  }

  @keyframes ghost {
    0%,
    22% {
      opacity: 1;
    }
    36%,
    100% {
      opacity: 0;
    }
  }

  @keyframes appear2 {
    0%,
    34% {
      opacity: 0;
    }
    44%,
    100% {
      opacity: 1;
    }
  }

  @keyframes shift {
    0%,
    30% {
      transform: none;
    }
    52%,
    100% {
      transform: translateX(48px);
    }
  }

  @keyframes dashflow {
    to {
      stroke-dashoffset: -7;
    }
  }
</style>
