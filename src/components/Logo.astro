---
/**
 * The vmono mark: a squircle frame (the session directory) around three
 * branches (the member worktrees) that merge into one cyan dot, the session
 * they land in. The frame and the first branch follow `currentColor`, so the
 * mark reads on both the light and dark backgrounds; the cyan and gray
 * strokes are fixed. Keep in sync with `public/favicon.svg`.
 */
interface Props {
  size?: number | string;
}

const { size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 512 512"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  <rect x="108" y="108" width="296" height="296" rx="104" stroke="currentColor" stroke-width="28"></rect>
  <g stroke-width="32" stroke-linecap="round">
    <path d="M171.8 165.5C171.8 251.3 256 235.7 256 346.5" stroke="currentColor"></path>
    <path d="M340.2 165.5C340.2 251.3 256 235.7 256 346.5" stroke="#5a5858"></path>
    <path d="M256 165.5V346.5" stroke="#5fd7ff"></path>
  </g>
  <circle cx="256" cy="346.5" r="24" fill="#5fd7ff"></circle>
</svg>
