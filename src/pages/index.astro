---
/**
 * Landing page. Top to bottom: the pitch beside a terminal showing what vmono
 * lays out on disk (colored by the site-wide concept palette), the install
 * command, three numbered steps, a framed screenshot of the TUI, and five
 * feature rows. Everything links into /docs. Copy is condensed from the vmono
 * README; the tree mirrors the layout described on the Concepts page.
 */
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Logo from "../components/Logo.astro";
import CodeTabs from "../components/CodeTabs.astro";
import Term from "../components/Term.astro";
import { REPO_URL, url } from "../lib/nav";
import type { Hue } from "../lib/nav";

const themes = { light: "github-light", dark: "github-dark-dimmed" } as const;

const unix = "curl -fsSL https://github.com/doneill612/vmono/releases/latest/download/install.sh | sh";
const windows = "irm https://github.com/doneill612/vmono/releases/latest/download/install.ps1 | iex";

/** Lines of the hero terminal: `kind` picks the concept color, `note` is the margin comment. */
const tree: { path: string; kind: "pkg" | "ses" | "act" | "ref" | "dim"; note: string }[] = [
  { path: "payments/", kind: "pkg", note: "package: defined once" },
  { path: "├── .vmono/manifest.toml", kind: "dim", note: "purpose, members, roles" },
  { path: "└── token-refresh/", kind: "ses", note: "session: its own branch" },
  { path: "    ├── AGENTS.md", kind: "dim", note: "rendered from the package" },
  { path: "    ├── api/", kind: "act", note: "active: a worktree you edit" },
  { path: "    ├── web/", kind: "act", note: "active" },
  { path: "    └── _ref/docs/", kind: "ref", note: "reference: read-only" },
];

const steps: { n: string; hue: Hue; title: string; body: string; cmd: string }[] = [
  {
    n: "01",
    hue: "violet",
    title: "Define a package",
    body: "Pick the repos and say why they belong together. You do this once.",
    cmd: "vmono new payments --active api,web --ref docs",
  },
  {
    n: "02",
    hue: "green",
    title: "Start a session",
    body: "A branch and a worktree of every member in one directory, ready for your harness.",
    cmd: "vmono session new payments token-refresh",
  },
  {
    n: "03",
    hue: "cyan",
    title: "Push it",
    body: "Each member's branch goes to its remote, ready for a pull request. Never forced, and only when you ask.",
    cmd: "vmono session push payments/token-refresh",
  },
];

const features: { hue: Hue; title: string; body: string }[] = [
  {
    hue: "cyan",
    title: "Worktrees, not copies",
    body: "Members are git worktrees of repos already on your machine: no copies, no re-clones, shared object storage.",
  },
  {
    hue: "violet",
    title: "Define once, session per task",
    body: "A package is a set of repos with a purpose. More work on the same repos is a new session with its own branch, so nothing is set up twice.",
  },
  {
    hue: "amber",
    title: "Context your agent reads",
    body: "The purpose, notes and each repo's role are written once and rendered into every session's AGENTS.md and CLAUDE.md.",
  },
  {
    hue: "green",
    title: "Works with your harness",
    body: "Claude Code, OpenCode, Codex and Pi work out of the box. A bundled skill teaches the agent to read the package and write back only what future sessions need, and another, installed once, lets any agent start sessions for you.",
  },
  {
    hue: "violet",
    title: "Agents side by side",
    body: "One command gives every session its own tmux session or herdr workspace, and a key opens the TUI in a popup to jump between running agents and see what each is doing.",
  },
];
---

<Base
  home
  title="vmono: many repos, one workspace for your coding agent"
  description="vmono defines a set of git repos once and gives each piece of work its own session: a branch and a worktree of every repo, ready for your coding agent."
>
  <Header />
  <main id="content">
    <section class="hero">
      <div class="pitch">
        <div class="mark"><Logo size={56} /></div>
        <h1>Many repos.<br />One workspace for your coding agent.</h1>
        <p class="sub">
          Define a set of repos once. Start a session for each piece of work: a branch and a git worktree of every
          repo, in one directory your harness opens.
        </p>
        <div class="actions">
          <a class="btn primary" href={url("/docs")}>Read the docs</a>
          <a class="btn" href={url("/docs/quick-start")}>Quick start</a>
          <a class="btn" href={REPO_URL} rel="noopener">GitHub</a>
        </div>
      </div>

      <figure class="terminal">
        <div class="bar">
          <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="title">~/.vmono</span>
        </div>
        <pre><code><span class="ln cmd"><span class="path"><span class="dim">$ </span>vmono new payments \</span></span><span class="ln cmd"><span class="path">    --active api,web --ref docs \</span></span><span class="ln cmd"><span class="path">    --session token-refresh</span></span><span class="ln gap"></span>{
          tree.map((l) => (
            <span class="ln">
              <span class={`path k-${l.kind}`}>{l.path}</span>
              <span class="note">{l.note}</span>
            </span>
          ))
        }</code></pre>
        <figcaption class="legend">
          <Term kind="package">package</Term>
          <Term kind="session">session</Term>
          <Term kind="active">active member</Term>
          <Term kind="reference">reference member</Term>
        </figcaption>
      </figure>
    </section>

    <section class="install" aria-labelledby="install-h">
      <h2 id="install-h" class="eyebrow" data-hue="cyan"><span class="dot" aria-hidden="true"></span>Install</h2>
      <CodeTabs tabs={[{ id: "unix", label: "macOS / Linux" }, { id: "windows", label: "Windows (PowerShell)" }]}>
        <Fragment slot="unix">
          <Code code={unix} lang="sh" themes={themes} defaultColor={false} />
        </Fragment>
        <Fragment slot="windows">
          <Code code={windows} lang="powershell" themes={themes} defaultColor={false} />
        </Fragment>
      </CodeTabs>
    </section>

    <section class="how" aria-labelledby="how-h">
      <h2 id="how-h" class="eyebrow" data-hue="green"><span class="dot" aria-hidden="true"></span>How it works</h2>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step" data-hue={s.hue}>
              <span class="n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
              <code class="step-cmd">
                <span class="dim">$ </span>
                {s.cmd}
              </code>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="shot" aria-label="The vmono TUI">
      <div class="bar">
        <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="title">vmono</span>
      </div>
      <img
        src={url("/vmono-ex.png")}
        width="3456"
        height="1842"
        alt="The vmono TUI showing the packages view: a list of packages beside a preview of the selected one"
        decoding="async"
      />
    </section>

    <section class="features" aria-label="Features">
      {
        features.map((f) => (
          <div class="row" data-hue={f.hue}>
            <h2>{f.title}</h2>
            <p>{f.body}</p>
          </div>
        ))
      }
    </section>
  </main>
  <Footer />
</Base>

<style>
  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .dim {
    color: var(--text-muted);
  }

  /* ---------- hero ---------- */

  .hero {
    display: grid;
    gap: 2.5rem;
    padding: 3.5rem 0 2.5rem;
  }

  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: center;
      gap: 3rem;
      padding: 5rem 0 3rem;
    }
  }

  .mark {
    margin-bottom: 1.5rem;
    color: var(--text);
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(var(--text-2xl), 4.2vw, var(--text-4xl));
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 700;
    color: var(--text);
  }

  .sub {
    max-width: 48ch;
    margin: 0 0 1.75rem;
    font-size: var(--text-md);
    line-height: 1.7;
    color: var(--text-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding: 0 1.1rem;
    font-size: var(--text-sm);
    color: var(--text);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .btn:hover {
    border-color: var(--text-muted);
  }

  .btn.primary {
    color: var(--accent-text);
    font-weight: 700;
    background: var(--accent-bg);
    border-color: var(--accent-bg);
  }

  .btn.primary:hover {
    filter: brightness(0.95);
  }

  /* ---------- window chrome shared by the terminal and the screenshot ---------- */

  .terminal,
  .shot {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--border-muted);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .lights {
    display: inline-flex;
    gap: 0.35rem;
  }

  .lights i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--border);
  }

  /* ---------- terminal ---------- */

  .terminal pre {
    margin: 0;
    padding: 1rem 1.1rem 0.5rem;
    overflow-x: auto;
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  .ln {
    display: flex;
    gap: 2rem;
    white-space: pre;
  }

  .ln.gap {
    height: 0.75rem;
  }

  .path {
    min-width: 26ch;
    color: var(--text);
  }

  .ln.cmd .path {
    min-width: 0;
  }

  .k-dim {
    color: var(--text-muted);
  }

  .k-pkg {
    color: var(--c-violet);
    font-weight: 700;
  }

  .k-ses {
    color: var(--c-green);
    font-weight: 700;
  }

  .k-act {
    color: var(--c-cyan);
    font-weight: 700;
  }

  .k-ref {
    color: var(--c-amber);
    font-weight: 700;
  }

  .note {
    color: var(--text-muted);
  }

  .note::before {
    content: "# ";
  }

  @media (max-width: 719px) {
    .note {
      display: none;
    }
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.7rem 1.1rem 0.9rem;
    border-top: 1px solid var(--border-muted);
    font-size: var(--text-xs);
  }

  /* ---------- sections ---------- */

  .install,
  .how,
  .shot {
    margin-top: 3rem;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hue);
  }

  .eyebrow .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 1px;
    background: var(--hue);
  }

  .install :global(.code-tabs) {
    max-width: 52rem;
  }

  /* ---------- steps ---------- */

  .steps {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .step {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.1rem 1.1rem;
    border: 1px solid var(--border);
    border-top: 3px solid var(--hue);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--hue) 5%, var(--bg));
  }

  .n {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--hue);
  }

  .step h3 {
    margin: 0.35rem 0 0.4rem;
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--text);
  }

  .step p {
    margin: 0 0 1rem;
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .step-cmd {
    margin-top: auto;
    padding: 0.5rem 0.7rem;
    overflow-x: auto;
    white-space: nowrap;
    font-size: var(--text-xs);
    color: var(--text);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
    background: var(--bg);
  }

  /* ---------- screenshot ---------- */

  .shot {
    background: #000;
  }

  .shot .bar {
    background: var(--bg-surface);
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- features ---------- */

  .features {
    margin-top: 3.5rem;
    border-top: 1px solid var(--border-muted);
  }

  .row {
    position: relative;
    display: grid;
    gap: 0.5rem 2rem;
    padding: 1.5rem 0 1.5rem 1.1rem;
    border-bottom: 1px solid var(--border-muted);
  }

  .row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.6rem;
    width: 3px;
    height: 1.1rem;
    border-radius: 1px;
    background: var(--hue);
  }

  @media (min-width: 768px) {
    .row {
      grid-template-columns: 18rem 1fr;
    }
  }

  .row h2 {
    margin: 0;
    font-size: var(--text-md);
    font-weight: 700;
    color: var(--text);
  }

  .row p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
</style>
